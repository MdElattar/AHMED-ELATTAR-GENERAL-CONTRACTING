# ─────────────────────────────────────────────────────────────────────────────
# Database — required in production. Local development falls back to the
# seeded in-process repository only when this URI is unreachable.
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/alattar_company
MONGODB_DB=alattar_company

# ─────────────────────────────────────────────────────────────────────────────
# Session / OTP signing secrets — each must be at least 32 characters.
# Generate with: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (Resend REST API). Required for real OTP delivery.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
OTP_FROM_EMAIL="Ahmed Elattar <no-reply@alattar.sa>"

# ─────────────────────────────────────────────────────────────────────────────
# First super-admin — consumed by the seed script (MongoDB) and by the local
# development repository. Change the password before deploying.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@alattar.sa
ADMIN_PASSWORD=change-this-super-admin-password
ADMIN_NAME=Platform Administrator
ADMIN_COMPANY=Ahmed Elattar General Contracting

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true only for ephemeral demos that cannot reach MongoDB.
ALLOW_IN_MEMORY_DB=false
