# ─────────────────────────────────────────────────────────────────────────────
# Database — required in production. Local development falls back to the
# seeded in-process repository only when this URI is unreachable.
# (MONGODB_URI canonical; MONGODB_URL also accepted)
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/alattar_company
MONGODB_URL=mongodb://127.0.0.1:27017/alattar_company
MONGODB_DB=alattar_company

# ─────────────────────────────────────────────────────────────────────────────
# Session / OTP signing secrets — each must be at least 32 characters.
# Generate with: openssl rand -base64 48
# (AUTH_SECRET canonical; JWT_SECRET/NEXTAUTH_SECRET also accepted)
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (Resend REST API). Required for real OTP delivery.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
OTP_FROM_EMAIL="Ahmed Alattar <alattar@aalattar.com>"

# ─────────────────────────────────────────────────────────────────────────────
# Admin instant alerts — email is delivered through Resend. WhatsApp supports
# either a generic webhook (n8n, Make, Twilio proxy) or the Meta Cloud API.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_ALERT_EMAIL=alattar@aalattar.com
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# ─────────────────────────────────────────────────────────────────────────────
# First super-admin — consumed by the seed script (MongoDB) and by the local
# development repository. Change the password before deploying.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=alattar@aalattar.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Platform Administrator
ADMIN_COMPANY=Ahmed Alattar General Contracting

# ─────────────────────────────────────────────────────────────────────────────
# Canonical public origin — required in production (https://)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional
# ─────────────────────────────────────────────────────────────────────────────
# Portal ownership demo account. Project records are assigned to this address
# at seed time; production data should carry real client emails instead.
PORTAL_DEMO_CLIENT_EMAIL=client@example.com
# Development only. Production always fails closed even when set to true.
ALLOW_IN_MEMORY_DB=false
# Set true only when a trusted proxy strips client-supplied X-Forwarded-For
# and sets X-Forwarded-Proto itself (used for HTTPS redirects and rate limits).
TRUST_PROXY_HEADERS=false

# ─────────────────────────────────────────────────────────────────────────────
# Passkeys / WebAuthn — required in production. Defaults to the request
# hostname in development. Set the bare production domain without protocol or
# port, e.g. alattar.sa. Preview URLs (*.vercel.app) cannot enrol passkeys.
# Extra staging domains can be added as a comma-separated allowlist.
# ─────────────────────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ID_ALLOWLIST=
